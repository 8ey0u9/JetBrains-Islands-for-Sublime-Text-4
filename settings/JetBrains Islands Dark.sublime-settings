// JetBrains Islands Dark — settings template.
// Install into Packages/User/Preferences.sublime-settings, or copy the
// values you need. Only theme-related keys are listed: fonts, indentation
// and every other personal preference are left to the user.
{
    "theme": "JetBrains Islands Dark.sublime-theme",
    "color_scheme": "JetBrains Islands Dark.sublime-color-scheme",

    // Islands-specific layout: pill tabs without scroll arrows, flat title bar.
    "file_tab_style": "rounded",
    "hide_tab_scrolling_buttons": true,
    "hide_new_tab_button": true,
    "themed_title_bar": true,
    "highlight_modified_tabs": true,
    "bold_folder_labels": true,
    "overlay_scroll_bars": "enabled",
    // Islands has no drop shadow between the editor and the minimap; Sublime
    // draws a 15 px dark gradient there when shadows are on.
    "draw_shadows": false,
    "show_tab_close_buttons_on_left": false,

    // --- Layout: match IntelliJ's opened-project window ----------------
    // There is no minimap toggle in Preferences: "show_minimap" is an internal
    // view flag, not a documented setting (the documented keys are
    // draw_minimap_border / always_show_minimap_viewport /
    // minimap_horizontal_scrolling). Only View > Hide Minimap turns it off,
    // per view, and that state is not persistable from a settings file.
    // IntelliJ's status bar has no sidebar toggle button.
    "show_sidebar_button": false,

    // Status bar: show line endings, encoding and indentation on the right,
    // matching IntelliJ's own status bar items.
    "show_encoding": true,
    "show_line_endings": true,
    "show_indentation": true,

    // Keep "auto" theme switching paired with the matching Islands flavour.
    "light_theme": "JetBrains Islands Light.sublime-theme",
    "dark_theme": "JetBrains Islands Dark.sublime-theme",
    "light_color_scheme": "JetBrains Islands Light.sublime-color-scheme",
    "dark_color_scheme": "JetBrains Islands Dark.sublime-color-scheme"
}
