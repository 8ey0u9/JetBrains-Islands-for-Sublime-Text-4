            "font_style": "italic"
        },
        {
            "name": "Documentation Comment",
            "scope": "comment.block.documentation, comment.line.documentation",
            "foreground": "var(doc_comment)",
            "font_style": "italic"
        },
        {
            "name": "Doc Comment Tag",
            "scope": "comment.block.documentation storage.type.class.doxygen, comment.block.documentation entity.name.type, comment.block.documentation keyword",
